export const metadata = buildMetadata({
  title: mipsContent.seo.title,
  description: mipsContent.seo.description,
  path: "/mips",
  keywords: [...mipsContent.seo.keywords],
});

export default function MipsPage() {
  return (
    <>
      <JsonLd
        data={breadcrumbSchema([
          { name: "Home", href: "/" },
          { name: "MIPS Services", href: "/mips" },
