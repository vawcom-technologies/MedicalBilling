      >
        <HeroStatsOverlay
          stats={[
            { label: "Categories Covered", value: "4", tone: "primary" },
            { label: "Deadline Focus", value: "100%", tone: "accent" },
            { label: "Planning Cadence", value: "12 mo", tone: "secondary" },
          ]}
        >
          <ServiceArt
            variant="mips"
            className="h-auto w-full drop-shadow-[0_24px_50px_rgba(15,76,129,0.12)]"
          />
